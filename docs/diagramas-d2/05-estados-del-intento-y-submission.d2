direction: right

attempt: Intento de evaluacion {
  active: ACTIVE
  completed: COMPLETED
  expired: EXPIRED
  active -> completed: todas las preguntas evaluadas
  active -> expired: vence expiresAt
}

submission: Submission {
  draft: DRAFT
  pending: PENDING
  evaluated: EVALUATED
  draft -> pending: reclamar para ejecucion
  pending -> evaluated: persistir resultados
  pending -> draft: error o liberacion de reclamo
}

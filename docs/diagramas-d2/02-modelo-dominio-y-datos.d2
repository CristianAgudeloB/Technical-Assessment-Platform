direction: right

user: User {
  shape: class
  id: String
  email: String unique
  role: ADMIN | CANDIDATE
}
assessment: Assessment {
  shape: class
  id: String
  durationMinutes: Int
  status: DRAFT | PUBLISHED | ARCHIVED
}
assignment: AssessmentAssignment {
  shape: class
  id: String
  availableFrom: DateTime
  availableUntil: DateTime
}
question: Question {
  shape: class
  id: String
  position: Int
  score: Decimal
}
language: QuestionAllowedLanguage {
  shape: class
  language: ProgrammingLanguage
}
test: TestCase {
  shape: class
  id: String
  position: Int
  isHidden: Boolean
}
attempt: AssessmentAttempt {
  shape: class
  id: String
  status: ACTIVE | COMPLETED | EXPIRED
  expiresAt: DateTime
  score: Decimal nullable
}
submission: Submission {
  shape: class
  id: String
  status: DRAFT | PENDING | EVALUATED
  language: ProgrammingLanguage
  score: Decimal nullable
}
testResult: TestResult {
  shape: class
  id: String
  status: TestResultStatus
  executionTimeMs: Int nullable
}

user "1" -> "0..*" assignment: recibe
assessment "1" -> "0..*" assignment: se asigna
assessment "1" -> "1..*" question: contiene
question "1" -> "1..*" language: permite
question "1" -> "0..*" test: define
user "1" -> "0..*" attempt: realiza
assessment "1" -> "0..*" attempt: instancia
attempt "1" -> "0..*" submission: agrupa
question "1" -> "0..*" submission: responde
submission "1" -> "0..*" testResult: produce
test "1" -> "0..*" testResult: evalua

direction: right

user: User {
  shape: class
  id: "String PK"
  email: "String unique"
  role: "ADMIN | CANDIDATE"
}

assessment: Assessment {
  shape: class
  id: "String PK"
  durationMinutes: Int
  status: "DRAFT | PUBLISHED | ARCHIVED"
}

assignment: AssessmentAssignment {
  shape: class
  id: "String PK"
  userId: "String FK"
  assessmentId: "String FK"
  availability: "availableFrom - availableUntil"
}

question: Question {
  shape: class
  id: "String PK"
  assessmentId: "String FK"
  position: Int
  score: Decimal
}

language: QuestionAllowedLanguage {
  shape: class
  questionId: "String FK"
  language: ProgrammingLanguage
}

test: TestCase {
  shape: class
  id: "String PK"
  questionId: "String FK"
  position: Int
  isHidden: Boolean
}

attempt: AssessmentAttempt {
  shape: class
  id: "String PK"
  assessmentId: "String FK"
  userId: "String FK nullable"
  status: "ACTIVE | COMPLETED | EXPIRED"
  expiresAt: DateTime
}

submission: Submission {
  shape: class
  id: "String PK"
  assessmentAttemptId: "String FK nullable"
  questionId: "String FK"
  status: "DRAFT | PENDING | EVALUATED"
}

testResult: TestResult {
  shape: class
  id: "String PK"
  submissionId: "String FK"
  testCaseId: "String FK"
  status: TestResultStatus
}

user -> assignment: "1 - 0..* recibe"
assessment -> assignment: "1 - 0..* se asigna"
assessment -> question: "1 - 0..* contiene"
question -> language: "1 - 0..* permite"
question -> test: "1 - 0..* define"
user -> attempt: "0..1 - 0..* realiza"
assessment -> attempt: "1 - 0..* instancia"
attempt -> submission: "0..1 - 0..* agrupa"
question -> submission: "1 - 0..* responde"
submission -> testResult: "1 - 0..* produce"
test -> testResult: "1 - 0..* evalua"

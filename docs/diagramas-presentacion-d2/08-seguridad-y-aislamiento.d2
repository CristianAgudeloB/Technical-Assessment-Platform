direction: right

candidate: Candidato { shape: person }
web: Aplicacion web

api: API NestJS {
  auth: JWT roles y asignacion vigente
  validation: Valida intento lenguaje y limites
  port: CodeExecutionPort
}

judge: Judge0 externo {
  sandbox: Ejecucion aislada
  limits: CPU memoria procesos y archivos
  network: Red deshabilitada
  timeout: Timeout de ejecucion
}

docker: Docker {
  apiContainer: API bajo usuario no privilegiado
  postgres: PostgreSQL para desarrollo local
}

candidate -> web: envia solucion
web -> api.auth: JWT
api.auth -> api.validation: acceso autorizado
api.validation -> api.port: codigo validado
api.port -> judge.sandbox: HTTPS no ejecucion nativa
judge.sandbox -> api: resultado normalizado
docker.apiContainer -> api: entorno de API
docker.postgres -> api: persistencia local

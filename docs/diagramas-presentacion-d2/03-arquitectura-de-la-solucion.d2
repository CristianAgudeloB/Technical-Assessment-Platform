direction: right

web: Aplicacion web {
  candidate: Portal del candidato
  admin: Portal administrativo
  editor: Editor de codigo Monaco
}

api: API NestJS {
  auth: Autenticacion JWT
  assessments: Evaluaciones y preguntas
  attempts: Intentos y resultados
  submissions: Submissions
  execution: Puerto de ejecucion
}

database: PostgreSQL {
  prisma: Prisma
}

judge: Judge0 {
  sandbox: Ejecucion aislada
}

web.candidate -> api.auth: inicia sesion
web.candidate -> api.assessments: consulta retos
web.candidate -> api.attempts: inicia intento
web.editor -> api.submissions: envia codigo
web.admin -> api.assessments: administra
api.auth -> database.prisma
api.assessments -> database.prisma
api.attempts -> database.prisma
api.submissions -> database.prisma
api.submissions -> api.execution
api.execution -> judge.sandbox: ejecuta codigo

direction: right

admin: Administrador { shape: person }
candidate: Candidato { shape: person }

platform: Plataforma de evaluaciones tecnicas {
  management: Configurar evaluaciones y preguntas
  assignment: Asignar evaluaciones y disponibilidad
  attempt: Resolver intento temporizado
  execution: Evaluar codigo y mostrar resultados
}

admin -> platform.management: crea y publica
admin -> platform.assignment: asigna
candidate -> platform.attempt: resuelve
candidate -> platform.execution: consulta
platform.management -> platform.assignment: evaluacion publicada
platform.assignment -> platform.attempt: acceso habilitado
platform.attempt -> platform.execution: envia solucion

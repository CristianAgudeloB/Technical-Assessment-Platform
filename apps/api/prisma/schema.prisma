generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  ADMIN
  CANDIDATE
}

enum AssessmentAttemptStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum ProgrammingLanguage {
  JAVA
  JAVASCRIPT
  PYTHON
  TYPESCRIPT
  COBOL
}

enum SubmissionStatus {
  DRAFT
  PENDING
  EVALUATED
}

enum TestResultStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  INTERNAL_ERROR
}

model Assessment {
  id              String                 @id @default(cuid())
  name            String                 @db.VarChar(160)
  description     String                 @db.Text
  durationMinutes Int
  status          AssessmentStatus       @default(DRAFT)
  publishedAt     DateTime?
  questions       Question[]
  attempts        AssessmentAttempt[]
  assignments     AssessmentAssignment[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status])
}

model Question {
  id               String                    @id @default(cuid())
  assessmentId     String
  title            String                    @db.VarChar(160)
  description      String                    @db.Text
  position         Int
  score            Decimal                   @default(10) @db.Decimal(5, 2)
  assessment       Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  allowedLanguages QuestionAllowedLanguage[]
  testCases        TestCase[]
  submissions      Submission[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([assessmentId, position])
  @@index([assessmentId])
}

model QuestionAllowedLanguage {
  questionId String
  language   ProgrammingLanguage
  question   Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([questionId, language])
}

model TestCase {
  id             String       @id @default(cuid())
  questionId     String
  position       Int
  input          String       @db.Text
  expectedOutput String       @db.Text
  isHidden       Boolean      @default(true)
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  results        TestResult[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([questionId, position])
  @@index([questionId])
}

model User {
  id           String                 @id @default(cuid())
  email        String                 @unique @db.VarChar(255)
  displayName  String                 @db.VarChar(160)
  passwordHash String                 @db.VarChar(255)
  role         UserRole               @default(CANDIDATE)
  attempts     AssessmentAttempt[]
  assignments  AssessmentAssignment[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([role])
}

model AssessmentAssignment {
  id             String     @id @default(cuid())
  userId         String
  assessmentId   String
  assignedAt     DateTime   @default(now())
  availableFrom  DateTime   @default(now())
  availableUntil DateTime
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([userId, assessmentId])
  @@index([userId])
  @@index([userId, availableFrom, availableUntil])
  @@index([assessmentId])
}

model AssessmentAttempt {
  id                    String                  @id @default(cuid())
  assessmentId          String
  userId                String?
  status                AssessmentAttemptStatus @default(ACTIVE)
  submissionCount       Int                     @default(0)
  previewExecutionCount Int                     @default(0)
  score                 Decimal?                @db.Decimal(5, 2)
  questionsCorrect      Int                     @default(0)
  questionsIncorrect    Int                     @default(0)
  completedQuestions    Int                     @default(0)
  timeConsumedSeconds   Int?
  startedAt             DateTime                @default(now())
  expiresAt             DateTime
  completedAt           DateTime?
  expiredAt             DateTime?
  assessment            Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user                  User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  submissions           Submission[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([assessmentId])
  @@index([userId])
  @@index([status, expiresAt])
}

model Submission {
  id                  String              @id @default(cuid())
  assessmentAttemptId String?
  questionId          String
  language            ProgrammingLanguage
  sourceCode          String              @db.Text
  status              SubmissionStatus    @default(DRAFT)
  score               Decimal?            @db.Decimal(5, 2)
  submittedAt         DateTime?
  assessmentAttempt   AssessmentAttempt?  @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)
  question            Question            @relation(fields: [questionId], references: [id], onDelete: Restrict)
  testResults         TestResult[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([assessmentAttemptId])
  @@index([questionId])
}

model TestResult {
  id              String           @id @default(cuid())
  submissionId    String
  testCaseId      String
  status          TestResultStatus @default(PENDING)
  stdout          String?          @db.Text
  stderr          String?          @db.Text
  compileOutput   String?          @db.Text
  executionTimeMs Int?
  memoryKb        Int?
  submission      Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase        TestCase         @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([submissionId, testCaseId])
  @@index([testCaseId])
}

# Local PostgreSQL used by docker-compose.yml
POSTGRES_USER=assessment_user
POSTGRES_PASSWORD=assessment_password
POSTGRES_DB=technical_assessment
POSTGRES_PORT=5432

# API
API_PORT=3000
DATABASE_URL=postgresql://assessment_user:assessment_password@localhost:5432/technical_assessment?schema=public

# Web
VITE_API_URL=http://localhost:3000

# Authentication
# Use a long, random value outside local development. Do not commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret

# First production administrator. Used only by the idempotent db:bootstrap command.
# Do not use demo credentials in a deployed environment.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_DISPLAY_NAME=Administrador
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-password

# Judge0 (use a self-hosted or authenticated endpoint outside local validation)
JUDGE0_BASE_URL=https://ce.judge0.com
# JUDGE0_AUTH_TOKEN=
JUDGE0_REQUEST_TIMEOUT_MS=8000
JUDGE0_TOTAL_TIMEOUT_MS=20000
JUDGE0_POLL_INTERVAL_MS=250
JUDGE0_MAX_POLLING_ATTEMPTS=60
JUDGE0_CPU_TIME_LIMIT_SECONDS=2
JUDGE0_WALL_TIME_LIMIT_SECONDS=5
JUDGE0_MEMORY_LIMIT_KB=128000
JUDGE0_MAX_PROCESSES=32
JUDGE0_MAX_FILE_SIZE_KB=1024

# SonarQube Community Build. Start it with: docker compose up -d sonarqube quality-worker
# These local values are examples only; use unique values for a shared environment.
SONARQUBE_ENABLED=true
QUALITY_WORKER_URL=http://localhost:3001
QUALITY_WORKER_PORT=3001
QUALITY_WORKER_TOKEN=replace-with-a-long-random-worker-token
QUALITY_ANALYSIS_TIMEOUT_MS=45000
SONARQUBE_PORT=9000
SONARQUBE_DB_PASSWORD=replace-with-a-strong-sonarqube-db-password
SONARQUBE_ADMIN_PASSWORD=replace-with-a-strong-admin-password-including-Aa1!
